# pixi environments
.pixi/*
!.pixi/config.toml

# The projections and the report beside them, written by `pixi run
# md-to-site` from data/ and rebuilt in CI. data/ is the source; these are
# not, so they are not carried in the history. `site/index.md` is: nothing
# generates it.
site/slide/
site/hymn/
site/subject.md
site/chorus.md

# Quarto render output. Its cache is ignored by site/.gitignore, which Quarto
# writes and maintains itself. A render builds each page beside its source and
# moves the lot into _site at the end, so the rest is what a render that stops
# early leaves behind.
site/_site/
site/site_libs/
site/*.html
!site/fit.html
!site/goto.html
!site/hymn-page.html
!site/title-slide.html
